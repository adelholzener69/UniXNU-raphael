diff --git a/bsd/dev/sweet_vibtorch.c b/bsd/dev/sweet_vibtorch.c
new file mode 100644
index 0000000..ecc66ce
--- /dev/null
+++ b/bsd/dev/sweet_vibtorch.c
@@ -0,0 +1,660 @@
+/*
+ * raphael (Redmi K20 Pro / Mi 9T Pro, SM8150): the vibration motor and the flashlight (patch 0263).
+ *
+ * Ported from HakiOS (drivers/haptic/hakios.raphael_haptic.c, drivers/camera/hakios.torch.c, raphael paths), onto
+ * this kernel's shared, whitelisted PMIC access (sweet_spmi.c) instead of HakiOS's own arbiter code:
+ *
+ *   vibration  PM8150B haptics block, SID 3 0xc000 (pm8150b_haptics, "qcom,haptics", an ERM). A constant drive of
+ *              VMAX (2552 mV, below the device tree's qcom,vmax-mv 3000), in the order of qti-haptics.c: CFG1
+ *              actuator type ERM (the block comes out of reset as LRA, and after `fastboot boot' Android's driver
+ *              never set it), VMAX_CFG, SEL (source = VMAX), EN_CTL1 on, PLAY; off: PLAY 0, EN_CTL1 0.
+ *   torch      PM8150L flash LED module ("flash v2"), SID 5 0xd300, channel 0 (led:torch_0) only, at most 100 mA,
+ *              in the order of leds-qpnp-flash-v2.c qpnp_flash_led_switch_set(): IRESOLUTION, software strobe,
+ *              ITARGET, safety timer off (0x13), MODULE_EN, EN_LED_CTRL. Guarded by the module's fault flag, its
+ *              supply-droop flag and the PM8150L temperature alarm (SID 5 0x2400).
+ *
+ * Off unless asked for (boot-args, one per part):
+ *   sweetvib=1 / sweettorch=1   a look, reading only: the block's type and subtype in the log
+ *   sweetvib=2 / sweettorch=2   ... and one test at boot: a buzz of sweetvib_ms (default 150, 20..1000) / the light at
+ *                               full torch current for sweettorch_s seconds (default 2, 1..10), then off
+ *   sweetvib=3 / sweettorch=3   ... and the part served until shutdown, no test at boot:
+ *                                 sysctl -w kern.sweet_vibrate=MS      buzz for MS ms (1..1000; 0 stops)
+ *                                 sysctl -w kern.sweet_torch=LEVEL     0 off, 1..1000 permille of 100 mA
+ *                               a read gives what runs now. The torch goes off after sweettorch_max_s (default 30,
+ *                               at most 120) and stays off until written anew.
+ *
+ * Every write is read back (except PLAY); a write that fails or does not read back, a short circuit, a fault or a
+ * temperature alarm stops the part and latches it off for the rest of the boot. sweet_vibtorch_quiesce() switches
+ * both off before a reboot, sweet_vibtorch_panic() on a panic (which stops the other CPUs, the worker with them: on
+ * the phone a panic during the boot buzz left the motor running until a forced restart).
+ *
+ * Not done here: iOS's own haptics (CoreHaptics / AVHapticPlayer) and Control Center's flashlight (AVFlashlight in
+ * mediaserverd) do not reach these sysctls; HakiOS does that with userland hooks this tree does not carry.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/sysctl.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+#include <sys/errno.h>
+#include <IOKit/IOLocks.h>
+#include "sweet_board.h"
+#include "sweet_spmi.h"
+
+extern kern_return_t thread_terminate(thread_t);
+
+void sweet_vibtorch_init(void);
+void sweet_vibtorch_quiesce(void);
+void sweet_vibtorch_panic(void);
+
+static uint64_t
+vt_now_ms(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_MSEC;
+}
+
+/* ---- one checked PMIC write -------------------------------------------------------------------------------------- */
+
+struct vt_part {
+	const char *name;
+	unsigned sid, base;
+	bool broken;    /* latched: no more writes this boot */
+	bool forcing;   /* the off writes pass the latch */
+	bool found;     /* the block answered: type, subtype */
+	uint8_t type, subtype;
+	const char *why;        /* what latched it */
+	unsigned read_why;      /* sweet_spmi_read_why() of the read that failed in the last probe */
+};
+
+static struct vt_part vt_hap = { .name = "SWEET VIB", .sid = 3, .base = 0xc000 };
+static struct vt_part vt_fl = { .name = "SWEET TORCH", .sid = 5, .base = 0xd300 };
+
+static void
+vt_give_up(struct vt_part *p, const char *why)
+{
+	if (!p->broken) {
+		p->broken = true;
+		p->why = why;
+		printf("%s: %s: no more writes this boot\n", p->name, why);
+	}
+}
+
+static bool
+vt_get(struct vt_part *p, unsigned reg, uint8_t *v)
+{
+	return sweet_spmi_read(p->sid, p->base + reg, v) == 0;
+}
+
+static bool
+vt_put(struct vt_part *p, unsigned reg, uint8_t value, bool readback)
+{
+	uint8_t back = 0xff;
+
+	if (p->broken && !p->forcing) {
+		return false;
+	}
+	if (sweet_spmi_write(p->sid, p->base + reg, &value, 1) != 0) {
+		printf("%s: %#x <- %#x refused or failed\n", p->name, p->base + reg, value);
+		vt_give_up(p, "a write that failed");
+		return false;
+	}
+	if (readback && (!vt_get(p, reg, &back) || back != value)) {
+		printf("%s: %#x <- %#x reads back %#x\n", p->name, p->base + reg, value, back);
+		vt_give_up(p, "a write that did not read back");
+		return false;
+	}
+	return true;
+}
+
+static bool
+vt_put_bits(struct vt_part *p, unsigned reg, uint8_t mask, uint8_t value)
+{
+	uint8_t now;
+
+	if (!vt_get(p, reg, &now)) {
+		vt_give_up(p, "a read that failed");
+		return false;
+	}
+	return (now & mask) == (value & mask) || vt_put(p, reg, (uint8_t)((now & ~mask) | (value & mask)), true);
+}
+
+/*
+ * The block's type and subtype, `tries' times 50 ms apart: on the phone the first read of the haptics block failed
+ * once at boot (and that used to switch vibration off for the whole boot).
+ */
+static bool
+vt_probe(struct vt_part *p, unsigned tries)
+{
+	uint8_t type = 0, subtype = 0;
+
+	for (unsigned i = 0;; i++) {
+		if (vt_get(p, 0x04, &type) && vt_get(p, 0x05, &subtype)) {
+			break;
+		}
+		p->read_why = sweet_spmi_read_why();
+		if (i + 1 >= tries) {
+			printf("%s: SID %u %#x cannot be read (SPMI %#x, %u tries)\n", p->name, p->sid, p->base,
+			    p->read_why, tries);
+			return false;
+		}
+		delay_for_interval(50, NSEC_PER_MSEC);
+	}
+	p->found = true;
+	p->type = type;
+	p->subtype = subtype;
+	p->read_why = 0;
+	printf("%s: SID %u %#x type %#x subtype %#x\n", p->name, p->sid, p->base, type, subtype);
+	return true;
+}
+
+/* ---- vibration: PM8150B haptics --------------------------------------------------------------------------------- */
+
+#define HAP_STATUS1     0x0a    /* [3] short circuit */
+#define HAP_EN_CTL1     0x46    /* [7] on */
+#define HAP_CFG1        0x4c    /* [0] actuator type: 0 LRA (reset), 1 ERM */
+#define HAP_CFG1_ERM    0x01
+#define HAP_SEL         0x4e    /* [5:4] waveform source, 0 = VMAX */
+#define HAP_VMAX_CFG    0x51    /* [5:1] 116 mV steps */
+#define HAP_PLAY        0x70    /* [7] play */
+#define HAP_VMAX_MV     2552
+#define HAP_VMAX_CODE   ((HAP_VMAX_MV / 116) << 1)
+#define HAP_MAX_MS      1000
+
+static bool hap_playing, hap_on;
+
+static bool
+hap_short(void)
+{
+	uint8_t s = 0;
+	return !vt_get(&vt_hap, HAP_STATUS1, &s) || (s & 0x08);
+}
+
+static bool
+hap_start(void)
+{
+	if (vt_hap.broken || (!vt_hap.found && !vt_probe(&vt_hap, 1))) {
+		return false;
+	}
+	if (hap_short()) {
+		vt_give_up(&vt_hap, "short circuit (or unreadable status)");
+		return false;
+	}
+	if (!vt_put_bits(&vt_hap, HAP_CFG1, 0x01, HAP_CFG1_ERM) ||
+	    !vt_put_bits(&vt_hap, HAP_VMAX_CFG, 0x3e, HAP_VMAX_CODE) || !vt_put_bits(&vt_hap, HAP_SEL, 0x31, 0x00)) {
+		return false;
+	}
+	hap_on = true;
+	if (!vt_put(&vt_hap, HAP_EN_CTL1, 0x80, true)) {
+		return false;
+	}
+	hap_playing = true;
+	return vt_put(&vt_hap, HAP_PLAY, 0x80, false);
+}
+
+static bool
+hap_stop(void)
+{
+	bool ok;
+
+	if (!hap_playing && !hap_on) {
+		return true;
+	}
+	vt_hap.forcing = true;
+	ok = vt_put(&vt_hap, HAP_PLAY, 0x00, false);
+	delay(1000);
+	ok = vt_put(&vt_hap, HAP_EN_CTL1, 0x00, true) && ok;
+	vt_hap.forcing = false;
+	if (ok) {
+		hap_playing = hap_on = false;
+	}
+	return ok;
+}
+
+/* ---- torch: PM8150L flash v2, channel 0 ------------------------------------------------------------------------- */
+
+#define FL_STATUS2      0x09    /* [4] supply drooped */
+#define FL_RT_STS       0x10    /* [0] fault */
+#define FL_SAFETY0      0x40
+#define FL_SAFETY_OFF   0x13
+#define FL_ITARGET0     0x43    /* [6:0] (code + 1) * 12.5 mA */
+#define FL_MODULE_EN    0x46    /* [7] */
+#define FL_IRES         0x47    /* [1:0] channel 0: 0 = 12.5 mA steps */
+#define FL_STROBE0      0x49    /* [2] hardware strobe */
+#define FL_EN_LED       0x4c    /* [0] channel 0 */
+#define FL_IRES_UA      12500u
+#define FL_MAX_MA       100u
+#define FL_ITARGET_MAX  7u      /* round(100 mA / 12.5 mA) - 1 */
+#define ALARM_SID       5
+#define ALARM_BASE      0x2400
+
+static bool fl_lit;
+static uint8_t alarm_subtype;
+static bool alarm_found;
+
+/* What would put the light out now, or NULL. */
+static const char *
+fl_trouble(void)
+{
+	uint8_t rt = 0, st2 = 0, alarm = 0, stage = 0;
+
+	if (!vt_get(&vt_fl, FL_RT_STS, &rt) || !vt_get(&vt_fl, FL_STATUS2, &st2)) {
+		return "a status read that failed";
+	}
+	if (alarm_found) {
+		if (sweet_spmi_read(ALARM_SID, ALARM_BASE + 0x08, &alarm) != 0) {
+			return "a temperature alarm read that failed";
+		}
+		stage = alarm_subtype == 0x08 ? (alarm & 0x03) : ((alarm >> 4) & 0x07);
+	}
+	if (rt & 0x01) {
+		return "the module reports a fault";
+	}
+	if (st2 & 0x10) {
+		return "the supply drooped";
+	}
+	if (stage != 0) {
+		return "the PM8150L temperature alarm is raised";
+	}
+	return NULL;
+}
+
+static bool
+fl_light(uint32_t permille)
+{
+	uint32_t ua = FL_MAX_MA * permille, code;
+	const char *why;
+
+	if (vt_fl.broken) {
+		return false;
+	}
+	if (ua < FL_IRES_UA) {
+		ua = FL_IRES_UA;
+	}
+	code = (ua + FL_IRES_UA / 2) / FL_IRES_UA - 1;
+	if (code > FL_ITARGET_MAX) {
+		code = FL_ITARGET_MAX;
+	}
+	if (!fl_lit && (why = fl_trouble()) != NULL) {
+		printf("SWEET TORCH: not lit: %s\n", why);
+		vt_give_up(&vt_fl, why);
+		return false;
+	}
+	if (!vt_put_bits(&vt_fl, FL_IRES, 0x03, 0x00) || !vt_put_bits(&vt_fl, FL_STROBE0, 0x04, 0x00) ||
+	    !vt_put_bits(&vt_fl, FL_ITARGET0, 0x7f, (uint8_t)code) || !vt_put(&vt_fl, FL_SAFETY0, FL_SAFETY_OFF, true)) {
+		return false;
+	}
+	if (!fl_lit) {
+		fl_lit = true;  /* before the enabling writes: one that lands but fails its read-back still gets fl_dark() */
+		if (!vt_put(&vt_fl, FL_MODULE_EN, 0x80, true) || !vt_put_bits(&vt_fl, FL_EN_LED, 0x01, 0x01)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static bool
+fl_dark(void)
+{
+	bool ok;
+
+	if (!fl_lit) {
+		return true;
+	}
+	vt_fl.forcing = true;
+	ok = vt_put_bits(&vt_fl, FL_EN_LED, 0x01, 0x00);
+	ok = vt_put(&vt_fl, FL_MODULE_EN, 0x00, true) && ok;
+	ok = vt_put_bits(&vt_fl, FL_ITARGET0, 0x7f, 0x00) && ok;
+	ok = vt_put(&vt_fl, FL_SAFETY0, FL_SAFETY_OFF, true) && ok;
+	vt_fl.forcing = false;
+	fl_lit = !ok;
+	return ok;
+}
+
+/* ---- requests (sysctl) and the worker thread -------------------------------------------------------------------- */
+
+static IOLock *vt_lock;
+static bool vt_pending, vt_leaving;
+static int vib_level, torch_level;
+static uint32_t vib_req_ms;             /* new buzz request, 0 none */
+static bool vib_req_stop;
+static uint32_t torch_req = 0;          /* wanted permille */
+static uint32_t torch_max_s = 30;
+static volatile uint32_t vib_now_ms_left, torch_now;    /* for reads */
+
+static void
+vt_kick(void)
+{
+	IOLockLock(vt_lock);
+	vt_pending = true;
+	IOLockWakeup(vt_lock, &vt_pending, false);
+	IOLockUnlock(vt_lock);
+}
+
+static int
+vt_vibrate_sysctl SYSCTL_HANDLER_ARGS
+{
+	(void)arg1;
+	(void)arg2;
+	int value = (int)vib_now_ms_left;
+	int error = sysctl_handle_int(oidp, &value, 0, req);
+
+	if (error || !req->newptr) {
+		return error;
+	}
+	if (vib_level < 3 || vt_lock == NULL) {
+		return ENODEV;
+	}
+	if (value < 0 || value > HAP_MAX_MS) {
+		return EINVAL;
+	}
+	IOLockLock(vt_lock);
+	vib_req_ms = (uint32_t)value;
+	vib_req_stop = value == 0;
+	IOLockUnlock(vt_lock);
+	vt_kick();
+	return 0;
+}
+
+static int
+vt_torch_sysctl SYSCTL_HANDLER_ARGS
+{
+	(void)arg1;
+	(void)arg2;
+	int value = (int)torch_now;
+	int error = sysctl_handle_int(oidp, &value, 0, req);
+
+	if (error || !req->newptr) {
+		return error;
+	}
+	if (torch_level < 3 || vt_lock == NULL) {
+		return ENODEV;
+	}
+	if (value < 0 || value > 1000) {
+		return EINVAL;
+	}
+	IOLockLock(vt_lock);
+	torch_req = (uint32_t)value;
+	IOLockUnlock(vt_lock);
+	vt_kick();
+	return 0;
+}
+
+/* kern.sweet_vibtorch_state: one line on both parts, for a look from a shell (the boot lines scroll out of the log). */
+static int
+vt_state_sysctl SYSCTL_HANDLER_ARGS
+{
+	(void)oidp;
+	(void)arg1;
+	(void)arg2;
+	char line[320];
+
+	snprintf(line, sizeof(line),
+	    "vib level %d found %d type %#x subtype %#x broken %d (%s) spmi %#x on %d playing %d left %u; "
+	    "torch level %d found %d type %#x subtype %#x broken %d (%s) spmi %#x lit %d now %u",
+	    vib_level, vt_hap.found, vt_hap.type, vt_hap.subtype, vt_hap.broken, vt_hap.why ? vt_hap.why : "-",
+	    vt_hap.read_why, hap_on, hap_playing, vib_now_ms_left,
+	    torch_level, vt_fl.found, vt_fl.type, vt_fl.subtype, vt_fl.broken, vt_fl.why ? vt_fl.why : "-",
+	    vt_fl.read_why, fl_lit, torch_now);
+	return sysctl_io_string(req, line, 0, 0, NULL);
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_vibtorch_state, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED, NULL, 0,
+    vt_state_sysctl, "A", "raphael: state of the vibration motor and flashlight driver (0263)");
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_vibrate, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 0,
+    vt_vibrate_sysctl, "I", "raphael: buzz the vibration motor for N ms (sweetvib=3; 0 stops)");
+SYSCTL_PROC(_kern, OID_AUTO, sweet_torch, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 0,
+    vt_torch_sysctl, "I", "raphael: flashlight level in permille of 100 mA (sweettorch=3; 0 off)");
+
+static void
+vt_sleep_ms(uint32_t ms)
+{
+	uint64_t deadline;
+
+	IOLockLock(vt_lock);
+	if (!vt_pending) {
+		if (ms == 0) {
+			IOLockSleep(vt_lock, &vt_pending, THREAD_UNINT);
+		} else {
+			clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+			IOLockSleepDeadline(vt_lock, &vt_pending, deadline, THREAD_UNINT);
+		}
+	}
+	vt_pending = false;
+	IOLockUnlock(vt_lock);
+}
+
+static void
+vt_boot_tests(void)
+{
+	if (vib_level == 2) {
+		uint32_t ms = 150;
+
+		(void)PE_parse_boot_argn("sweetvib_ms", &ms, sizeof(ms));
+		ms = ms < 20 ? 20 : ms > HAP_MAX_MS ? HAP_MAX_MS : ms;
+		printf("SWEET VIB: test buzz %u ms at %u mV\n", ms, HAP_VMAX_MV);
+		if (hap_start()) {
+			uint8_t s = 0;
+			delay_for_interval(ms, NSEC_PER_MSEC);
+			(void)vt_get(&vt_hap, HAP_STATUS1, &s);
+			printf("SWEET VIB: status while running %#x%s\n", s, (s & 0x08) ? " (SHORT CIRCUIT)" : "");
+		}
+		printf("SWEET VIB: %s\n", hap_stop() ? "stopped" : "COULD NOT BE STOPPED");
+	}
+	if (torch_level == 2) {
+		uint32_t secs = 2;
+
+		(void)PE_parse_boot_argn("sweettorch_s", &secs, sizeof(secs));
+		secs = secs < 1 ? 1 : secs > 10 ? 10 : secs;
+		printf("SWEET TORCH: test light %u s at %u mA\n", secs, FL_MAX_MA);
+		if (fl_light(1000)) {
+			for (uint32_t t = 0; t < secs * 10; ++t) {
+				const char *why;
+				delay_for_interval(100, NSEC_PER_MSEC);
+				if ((why = fl_trouble()) != NULL) {
+					printf("SWEET TORCH: %s while lit\n", why);
+					break;
+				}
+			}
+		}
+		printf("SWEET TORCH: %s\n", fl_dark() ? "off" : "COULD NOT BE SWITCHED OFF");
+	}
+}
+
+static void
+vt_thread(void *arg, wait_result_t wr)
+{
+	(void)arg;
+	(void)wr;
+	uint64_t vib_until = 0, torch_since = 0, last_check = 0;
+	uint32_t torch_cur = 0;
+
+	if (sweet_spmi_init() != 0) {
+		printf("SWEET VIB/TORCH: no SPMI, nothing done\n");
+		thread_terminate(current_thread());
+		return;
+	}
+	if (vib_level) {
+		/* not found now: kept at its level, hap_start() looks again when a buzz is asked for */
+		(void)vt_probe(&vt_hap, 10);
+	}
+	if (torch_level) {
+		if (!vt_probe(&vt_fl, 10) || vt_fl.type != 0x18) {
+			printf("SWEET TORCH: not a flash LED module (type %#x), nothing written\n", vt_fl.type);
+			vt_fl.why = "not a flash LED module";
+			torch_level = 0;
+		} else if (sweet_spmi_read(ALARM_SID, ALARM_BASE + 0x05, &alarm_subtype) == 0) {
+			alarm_found = true;
+			printf("SWEET TORCH: PM8150L temperature alarm subtype %#x\n", alarm_subtype);
+		}
+	}
+	sweet_spmi_vibtorch_writes(vib_level >= 2, torch_level >= 2);
+	vt_boot_tests();
+	if (vib_level < 3 && torch_level < 3) {
+		thread_terminate(current_thread());
+		return;
+	}
+	printf("SWEET VIB/TORCH: serving%s%s\n", vib_level >= 3 ? " kern.sweet_vibrate" : "",
+	    torch_level >= 3 ? " kern.sweet_torch" : "");
+	for (;;) {
+		uint32_t want_ms, want_torch;
+		bool want_stop;
+
+		IOLockLock(vt_lock);
+		want_ms = vib_req_ms;
+		want_stop = vib_req_stop;
+		want_torch = torch_req;
+		vib_req_ms = 0;
+		vib_req_stop = false;
+		IOLockUnlock(vt_lock);
+
+		uint64_t now = vt_now_ms();
+		if (vt_leaving) {
+			break;
+		}
+		/* vibration */
+		if (vib_level >= 3) {
+			if (want_stop) {
+				vib_until = 0;
+			} else if (want_ms != 0) {
+				vib_until = now + want_ms;
+				if (!hap_playing && !hap_start()) {
+					(void)hap_stop();
+					vib_until = 0;
+				}
+			}
+			if (hap_playing && (now >= vib_until || hap_short())) {
+				if (now < vib_until) {
+					vt_give_up(&vt_hap, "short circuit while running");
+				}
+				(void)hap_stop();
+				vib_until = 0;
+			}
+			vib_now_ms_left = hap_playing && vib_until > now ? (uint32_t)(vib_until - now) : 0;
+		}
+		/* torch */
+		if (torch_level >= 3) {
+			if (want_torch != torch_cur) {
+				if (want_torch == 0) {
+					(void)fl_dark();
+				} else if (fl_light(want_torch)) {
+					if (torch_cur == 0) {
+						torch_since = now;
+					}
+					printf("SWEET TORCH: on, %u/1000 of %u mA\n", want_torch, FL_MAX_MA);
+				} else {
+					(void)fl_dark();
+					want_torch = 0;
+				}
+				torch_cur = fl_lit ? want_torch : 0;
+			}
+			if (fl_lit && now - last_check >= 100) {
+				const char *why = fl_trouble();
+				last_check = now;
+				if (why != NULL || now - torch_since >= torch_max_s * 1000ull) {
+					printf("SWEET TORCH: off: %s\n", why ? why : "time limit");
+					if (why) {
+						vt_give_up(&vt_fl, why);
+					}
+					(void)fl_dark();
+					torch_cur = 0;
+					IOLockLock(vt_lock);
+					if (torch_req == want_torch) {
+						torch_req = 0;  /* stays off until asked anew */
+					}
+					IOLockUnlock(vt_lock);
+				}
+			}
+			torch_now = torch_cur;
+		}
+		vt_sleep_ms(hap_playing ? 5 : fl_lit ? 100 : 0);
+	}
+	thread_terminate(current_thread());
+}
+
+void
+sweet_vibtorch_init(void)
+{
+	thread_t thread;
+	uint32_t v;
+
+	if (!sweet_board_raphael()) {
+		return;
+	}
+	v = 0;
+	if (PE_parse_boot_argn("sweetvib", &v, sizeof(v)) && v > 0) {
+		vib_level = v > 3 ? 3 : (int)v;
+	}
+	v = 0;
+	if (PE_parse_boot_argn("sweettorch", &v, sizeof(v)) && v > 0) {
+		torch_level = v > 3 ? 3 : (int)v;
+	}
+	if (PE_parse_boot_argn("sweettorch_max_s", &v, sizeof(v)) && v >= 1) {
+		torch_max_s = v > 120 ? 120 : v;
+	}
+	if (!vib_level && !torch_level) {
+		return;
+	}
+	vt_lock = IOLockAlloc();
+	if (vt_lock == NULL || kernel_thread_start(vt_thread, NULL, &thread) != KERN_SUCCESS) {
+		printf("SWEET VIB/TORCH: could not start\n");
+		vib_level = torch_level = 0;
+		return;
+	}
+	thread_deallocate(thread);
+	printf("SWEET VIB/TORCH: sweetvib=%d sweettorch=%d\n", vib_level, torch_level);
+}
+
+/* Before a reboot (thread context, not a panic): both off. */
+void
+sweet_vibtorch_quiesce(void)
+{
+	if (!sweet_board_raphael() || vt_lock == NULL) {
+		return;
+	}
+	vt_leaving = true;
+	vt_kick();
+	delay_for_interval(20, NSEC_PER_MSEC);    /* let the worker leave its loop */
+	if (hap_playing || hap_on) {
+		vt_hap.broken = false;
+		printf("SWEET VIB: before reboot: %s\n", hap_stop() ? "stopped" : "COULD NOT BE STOPPED");
+	}
+	if (fl_lit) {
+		vt_fl.broken = false;
+		printf("SWEET TORCH: before reboot: %s\n", fl_dark() ? "off" : "COULD NOT BE SWITCHED OFF");
+	}
+}
+
+/*
+ * On a panic's way out (SweetPlatformExpert::haltRestart, kPEPanicBegin and after, via sweet_reboot_note_panic):
+ * both off. The other CPUs are stopped, so the worker may be anywhere, even inside an SPMI access; from here on the
+ * SPMI lock is only tried (sweet_spmi_atomic) and nothing sleeps or maps: the write channels were mapped when the
+ * parts were switched on. Once only.
+ */
+void
+sweet_vibtorch_panic(void)
+{
+	static bool done;
+
+	if (done || !sweet_board_raphael()) {
+		return;
+	}
+	done = true;
+	if (!(hap_playing || hap_on || fl_lit)) {
+		return;
+	}
+	sweet_spmi_atomic();
+	if (hap_playing || hap_on) {
+		vt_hap.broken = false;
+		(void)hap_stop();
+	}
+	if (fl_lit) {
+		vt_fl.broken = false;
+		(void)fl_dark();
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
