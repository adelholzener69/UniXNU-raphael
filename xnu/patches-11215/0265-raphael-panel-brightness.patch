new file mode 100644
index 0000000..4d975db
--- /dev/null
+++ b/bsd/dev/sweet_dsibl.c
@@ -0,0 +1,255 @@
+/*
+ * raphael (Redmi K20 Pro / Mi 9T Pro, SM8150): the panel's brightness (patch 0265).
+ *
+ * The panel is an AMOLED (Samsung EA8076) with no backlight: its brightness is DCS "set display brightness" (0x51) with
+ * an 11-bit level, 2..2047, high bits first (device tree: qcom,mdss-dsi-bl-pmic-control-type "bl_ctrl_dcs",
+ * bl-min-level 2, bl-max-level 0x7ff). Ported from HakiOS (drivers/gpu/hakios.adreno.c, raphael_dsi_send() and
+ * raphael_dsi_brightness()): the command goes through the DSI0 controller's DMA command engine, which the firmware left
+ * running with the panel, as Qualcomm's driver sends it:
+ *   packet: bytes 0-1 word count, byte 2 data type (0x39, DCS long write), byte 3 flags (bit 7 last, bit 6 long packet),
+ *   then the payload padded to 4 bytes (the hardware adds ECC and CRC);
+ *   DSI_COMMAND_MODE_DMA_CTRL 0x3c, DSI_DMA_CMD_OFFSET 0x48, DSI_DMA_CMD_LENGTH 0x4c, DSI_TRIG_CTRL 0x80 (bits 7:4 the
+ *   DMA trigger, 4 = software), DSI_CMD_MODE_DMA_SW_TRIGGER 0x90; DMA_CTRL and TRIG_CTRL are put back afterwards.
+ * The command buffer is one page of the firmware's display region (cont_splash, 0x9c000000 + 36 MiB) that the display
+ * hardware can read and nothing here uses: 0x9de00000, past the visible frame (raphael's framebuffer is copy mode).
+ *
+ * Off unless asked for:
+ *   sweetbl=1   a look, reading only: the DSI0 controller's registers in the log
+ *   sweetbl=2   ... and brightness served until shutdown:
+ *                 sysctl -w kern.sweet_brightness=N     0..1000; a read gives the last level sent (-1 none yet)
+ *               and, with the backlight service on (sweetfb_blsvc=1), what iOS asks of it (SweetFramebuffer.cpp).
+ * Level from the sysctl: 2 + N^2 * 2045 / 10^6 (HakiOS's curve for a slider position: fine steps at the dark end).
+ * Level from iOS: CoreBrightness asks for light (nits, linear), and an AMOLED's light goes roughly with the square of
+ * its level, so that path takes the square root: 2 + sqrt(L / 4095) * 2045. 0 is the dimmest level, never off.
+ * Nothing is sent unless the controller reads as enabled (DSI_CTRL bit 0) with a non-zero hardware version.
+ * One worker sends; requests arriving faster than it sends are coalesced (the last one wins).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/sysctl.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+#include <sys/errno.h>
+#include <IOKit/IOLocks.h>
+#include "sweet_board.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t thread_terminate(thread_t);
+
+void sweet_dsibl_init(void);
+void sweet_dsibl_request(uint32_t permille);
+void sweet_dsibl_request_light(uint32_t light);
+
+#define DSI_PHYS        0x0ae94000ull
+#define DSI_CMD_PA      0x9de00000ull
+#define DSI_HW_VERSION  0x000
+#define DSI_CTRL        0x004
+#define DSI_STATUS      0x008
+#define DSI_DMA_CTRL    0x03c
+#define DSI_DMA_OFFSET  0x048
+#define DSI_DMA_LENGTH  0x04c
+#define DSI_ACK_ERR     0x068
+#define DSI_TRIG_CTRL   0x080
+#define DSI_DMA_TRIGGER 0x090
+#define DSI_INT_CTRL    0x110
+#define BL_DBV_MIN      2u
+#define BL_DBV_MAX      2047u
+
+static vm_offset_t bl_dsi, bl_cmd;
+static IOLock *bl_lock;
+static int bl_level;                    /* boot-arg sweetbl */
+static bool bl_pending;
+static uint32_t bl_want;                /* panel level (DBV), under bl_lock */
+static int bl_sent = -1;                /* last permille sent, for reads */
+static uint32_t bl_sends, bl_refused;
+
+static uint32_t
+bl_rd(uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(bl_dsi + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+bl_wr(uint32_t off, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(bl_dsi + off) = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+static void
+bl_regs(const char *when)
+{
+	printf("SWEET BL: %s: version %08x ctrl %08x status %08x dmactrl %08x offset %08x length %08x trig %08x dmatrig %08x "
+	    "int %08x ackerr %08x\n", when, bl_rd(DSI_HW_VERSION), bl_rd(DSI_CTRL), bl_rd(DSI_STATUS), bl_rd(DSI_DMA_CTRL),
+	    bl_rd(DSI_DMA_OFFSET), bl_rd(DSI_DMA_LENGTH), bl_rd(DSI_TRIG_CTRL), bl_rd(DSI_DMA_TRIGGER), bl_rd(DSI_INT_CTRL),
+	    bl_rd(DSI_ACK_ERR));
+}
+
+static uint32_t
+bl_isqrt(uint32_t v)
+{
+	uint32_t r = 0;
+
+	for (uint32_t bit = 1u << 15; bit != 0; bit >>= 1) {
+		if ((r | bit) * (r | bit) <= v) {
+			r |= bit;
+		}
+	}
+	return r;
+}
+
+static uint32_t
+bl_dbv(uint32_t permille)
+{
+	return BL_DBV_MIN + (permille * permille * (BL_DBV_MAX - BL_DBV_MIN)) / 1000000u;
+}
+
+/* One DCS 0x51 through the DMA command engine. False: the controller is not in a state to send (nothing written). */
+static bool
+bl_send(uint32_t dbv)
+{
+	uint8_t packet[8] = { 0x03, 0x00, 0x39, 0xc0, 0x51, (uint8_t)((dbv >> 8) & 7), (uint8_t)(dbv & 0xff), 0x00 };
+	uint32_t trig, dma_ctrl;
+	bool show = bl_sends < 4;
+
+	if (bl_rd(DSI_HW_VERSION) == 0 || !(bl_rd(DSI_CTRL) & 1u)) {
+		if (bl_refused++ < 4) {
+			bl_regs("controller not enabled, nothing sent");
+		}
+		return false;
+	}
+	if (show) {
+		bl_regs("before");
+	}
+	memcpy((void *)bl_cmd, packet, sizeof(packet));
+	__asm__ volatile ("dsb sy" ::: "memory");
+	trig = bl_rd(DSI_TRIG_CTRL);
+	dma_ctrl = bl_rd(DSI_DMA_CTRL);
+	bl_wr(DSI_TRIG_CTRL, (trig & ~(0xfu << 4)) | (4u << 4));
+	bl_wr(DSI_DMA_CTRL, 0x10000000u | (1u << 26));
+	bl_wr(DSI_DMA_OFFSET, (uint32_t)DSI_CMD_PA);
+	bl_wr(DSI_DMA_LENGTH, sizeof(packet));
+	bl_wr(DSI_DMA_TRIGGER, 1);
+	delay_for_interval(5, NSEC_PER_MSEC);
+	bl_wr(DSI_DMA_CTRL, dma_ctrl);
+	bl_wr(DSI_TRIG_CTRL, trig);
+	bl_sends++;
+	if (show) {
+		bl_regs("after");
+		printf("SWEET BL: sent DCS 0x51 %02x %02x (level %u of %u)\n", packet[5], packet[6], dbv, BL_DBV_MAX);
+	}
+	return true;
+}
+
+static void
+bl_thread(void *arg, wait_result_t wr)
+{
+	(void)arg;
+	(void)wr;
+	for (;;) {
+		uint32_t want;
+
+		IOLockLock(bl_lock);
+		while (!bl_pending) {
+			IOLockSleep(bl_lock, &bl_pending, THREAD_UNINT);
+		}
+		bl_pending = false;
+		want = bl_want;
+		IOLockUnlock(bl_lock);
+		if (bl_send(want)) {
+			/* as the sysctl's scale (the inverse of bl_dbv) */
+			bl_sent = (int)bl_isqrt((want - BL_DBV_MIN) * 1000000u / (BL_DBV_MAX - BL_DBV_MIN));
+		}
+		delay_for_interval(15, NSEC_PER_MSEC);  /* with the 5 ms of a send: at most 50 commands a second */
+	}
+}
+
+static void
+bl_ask(uint32_t dbv)
+{
+	if (bl_level < 2 || bl_lock == NULL) {
+		return;
+	}
+	IOLockLock(bl_lock);
+	bl_want = dbv;
+	bl_pending = true;
+	IOLockWakeup(bl_lock, &bl_pending, false);
+	IOLockUnlock(bl_lock);
+}
+
+/* Any thread: ask for a brightness by slider position, 0..1000 (more is 1000). Ignored unless sweetbl=2. */
+void
+sweet_dsibl_request(uint32_t permille)
+{
+	bl_ask(bl_dbv(permille > 1000 ? 1000 : permille));
+}
+
+/* Any thread: ask for an amount of light, 0..4095 of the panel's most (iOS's backlight service). */
+void
+sweet_dsibl_request_light(uint32_t light)
+{
+	if (light > 4095) {
+		light = 4095;
+	}
+	bl_ask(BL_DBV_MIN + bl_isqrt(light * 4095u) * (BL_DBV_MAX - BL_DBV_MIN) / 4095u);
+}
+
+static int
+bl_sysctl SYSCTL_HANDLER_ARGS
+{
+	(void)arg1;
+	(void)arg2;
+	int value = bl_sent;
+	int error = sysctl_handle_int(oidp, &value, 0, req);
+
+	if (error || !req->newptr) {
+		return error;
+	}
+	if (bl_level < 2 || bl_lock == NULL) {
+		return ENODEV;
+	}
+	if (value < 0 || value > 1000) {
+		return EINVAL;
+	}
+	sweet_dsibl_request((uint32_t)value);
+	return 0;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_brightness, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED, NULL, 0,
+    bl_sysctl, "I", "raphael: panel brightness 0..1000 (sweetbl=2); a read gives the last level sent");
+
+void
+sweet_dsibl_init(void)
+{
+	thread_t thread;
+	uint32_t v = 0;
+
+	if (!sweet_board_raphael() || !PE_parse_boot_argn("sweetbl", &v, sizeof(v)) || v == 0) {
+		return;
+	}
+	bl_dsi = ml_io_map(DSI_PHYS, 0x400);
+	if (bl_dsi == 0) {
+		printf("SWEET BL: DSI0 map failed\n");
+		return;
+	}
+	bl_regs("look");
+	if (v < 2) {
+		return;
+	}
+	bl_cmd = ml_io_map(DSI_CMD_PA, 0x1000);
+	bl_lock = IOLockAlloc();
+	if (bl_cmd == 0 || bl_lock == NULL || kernel_thread_start(bl_thread, NULL, &thread) != KERN_SUCCESS) {
+		printf("SWEET BL: could not start\n");
+		bl_lock = NULL;
+		return;
+	}
+	thread_deallocate(thread);
+	bl_level = 2;
+	printf("SWEET BL: serving kern.sweet_brightness (DCS 0x51 through DSI0, command buffer at 0x%llx)\n", DSI_CMD_PA);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
