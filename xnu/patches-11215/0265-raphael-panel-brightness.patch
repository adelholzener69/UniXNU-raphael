+/*
+ * 0243 (0249: off until CoreBrightness can take it, it crashed backboardd; sweetfb_blsvc=1 on): publish the backlight
+ * service under the framebuffer, brightness 0..4095 with `value' as the current one.
+ */
+void
+AppleCLCD::blPublish(uint32_t value)
+{
+	int blsvc = 0;
+
+	PE_parse_boot_argn("sweetfb_blsvc", &blsvc, sizeof(blsvc));
